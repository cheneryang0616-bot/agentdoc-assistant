# 复制到 ~/.agentdoc.env 并填入自己的 Key（该文件不要提交到 git）
#
# 用法：
#   cp .env.example ~/.agentdoc.env
#   vim ~/.agentdoc.env
#   bash scripts/run_with_llm.sh --demo
#
# 注意：DeepSeek 的 Key 必须带 sk- 前缀

# ---- LLM（任选其一）----
export AGENTDOC_LLM_PROVIDER=deepseek
export DEEPSEEK_API_KEY=sk-请替换为你的key
export AGENTDOC_MODEL=deepseek-chat

# export AGENTDOC_LLM_PROVIDER=dashscope
# export DASHSCOPE_API_KEY=sk-xxx
# export AGENTDOC_MODEL=qwen-plus

# export AGENTDOC_LLM_PROVIDER=ollama
# export AGENTDOC_MODEL=qwen2.5:7b

# ---- 嵌入（可选）----
# auto: 本地有 BGE 缓存就用真实模型，否则哈希
export AGENTDOC_EMBEDDER=auto
# export AGENTDOC_ST_MODEL=BAAI/bge-small-zh-v1.5

# ---- 模型下载镜像（国内）----
export HF_ENDPOINT=https://hf-mirror.com
export USE_TF=0
